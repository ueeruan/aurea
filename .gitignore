# SDK local do projeto (3 GB) - nunca versionar
.tooling/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Published source archives used to vendor the renderer adapter.
/tmp/
output/
android/.kotlin/
*.apk
*.ipa

# A chave de assinatura do Android e o arquivo que aponta para ela.
android/key.properties
*.jks
*.keystore

# Configuracao local do Claude Code (caminhos da maquina), nao do projeto.
.claude/settings.local.json

# Saida de build do Gradle (relatorios, intermediates).
android/build/

# As dependencias do 3D (Diligent, Assimp) sao clonadas, nao versionadas:
# sao 58 MB de fonte de terceiro. O hook as le do disco quando o 3D for
# ligado de verdade — ver docs/3d-diligent.md, secao 7.
packages/aurea_render/third_party/
