<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest do Aurea.

  O applicationId, o label e o ícone são os MESMOS do Aurea oficial — é o que
  faz o APK novo substituir a instalação existente em vez de virar um segundo
  app. Ver _identity/signing/IDENTIDADE.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rede: conta (obrigatória), comunidade, relatório de crash, IA de
         vídeo, avisos, download do modelo de legendas e anúncios. Tudo HTTPS
         (usesCleartextTraffic="false"). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Leitura de mídia para a GALERIA do editor (Adicionar → mídia), pedida
         só quando ela abre; o seletor de fotos do sistema (PickVisualMedia)
         continua como alternativa sem permissão. Editor de vídeo = uso
         principal (política "Photo and Video Permissions" do Google Play).
         A partir do Android 13 o acesso é por tipo; antes, READ_EXTERNAL_STORAGE.
         READ_MEDIA_AUDIO saiu (Play, 10/2026): o áudio entra pelo seletor de
         documentos (SAF), que não pede permissão. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Só Android 8–9 (API ≤ 28): o export vai para a pasta PÚBLICA
         (Filmes/Imagens/Downloads › Aurea) para aparecer na galeria — a pasta
         do app não é indexada nesses sistemas ("o vídeo exportado não aparece
         na galeria", beta 07/10). Pedida na tela Exportar; negada, o arquivo
         fica na pasta do app (GalleryPublish.kt). Do Android 10 em diante o
         MediaStore não pede permissão. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- ID de publicidade: os SDKs de anúncio (LevelPlay/Unity Ads, AdMob) o
         usam. Explícito para não depender do merge das bibliotecas; o Play
         Console tem de declarar "usa ID de publicidade: sim (publicidade)". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <!-- Fase 8I (§185, §195): saíram CAMERA, RECORD_AUDIO (não há captura no
         editor), REQUEST_INSTALL_PACKAGES (não há atualização dentro do app)
         e WRITE_EXTERNAL_STORAGE (voltou em 10/2026 só até a API 28, para o
         export aparecer na galeria do Android 8–9 — ver acima). Permissão
         declarada sem recurso que a use é promessa falsa na loja. -->

    <!-- Vulkan is preferred; OpenGL ES 3.1 is the fallback. Floating-point
         render target support is checked against the driver at startup. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400000"
        android:required="false"/>
    <uses-feature android:glEsVersion="0x00030001" android:required="true"/>

    <!-- allowBackup=false + dataExtractionRules excluindo tudo: decisão
         documentada em res/xml/data_extraction_rules.xml (caches de GB; projeto
         restaurado sem a mídia da sandbox viraria camadas órfãs).
         largeHeap: miniaturas, imagens importadas e prévias de efeito vivem em
         Bitmap no heap Java; o motor é nativo, mas sem largeHeap aparelhos com
         heap padrão de 192–256 MB estouram ao abrir projeto com muitas imagens. -->
    <application
        android:name=".AureaApplication"
        android:label="Aurea Beta"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/AureaTheme">

        <!-- AdMob: o App ID vem de res/values*/ads_config.xml (debug = teste do
             Google; release = o real). As duas flags tiram a inicialização e o
             carregamento de anúncio da thread principal. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id"/>
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true"/>
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true"/>

        <!-- Android 8–9 exports stay in app-owned storage and are shared via scoped content URIs. -->
        <provider
            android:name=".state.ExportFileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/export_paths"/>
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.aurea.aurea"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize"
            android:theme="@style/AureaTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Abrir um .aurea de fora do app (gerenciador de arquivos,
                 compartilhamento). O motor precisa saber que estes arquivos
                 são dele. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/x-aurea-project"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
