    <string name="fx045g_name_hyper_glitch">Hyper Glitch</string>
    <string name="fx045g_desc_hyper_glitch">Glitch intenso: franjas que se deslizan, bloques fuera de lugar, separación RGB, estelas de píxeles, compresión y colores cambiados, todo con una intensidad y una semilla animables.</string>
