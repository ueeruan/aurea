    <string name="fx045g_name_hyper_glitch">Hyper Glitch</string>
    <string name="fx045g_desc_hyper_glitch">Glitch berat: irisan yang bergeser, blok yang berpindah, pemisahan RGB, jejak piksel, kompresi, dan warna tertukar — semua dikendalikan satu intensitas dan seed yang bisa dianimasikan.</string>
    <string name="fx045g_name_block_glitch">Glitch blok</string>
    <string name="fx045g_desc_block_glitch">Blok persegi panjang bergeser, dengan kanal tertukar dan terpisah, bergaya Block Glitch DaVinci Resolve. Atur ukuran, jumlah, dan frekuensi blok.</string>
    <string name="fx045g_name_shift_channels">Geser kanal</string>
