<resources>
    <string name="fx045g_name_hyper_glitch">Hyper Glitch</string>
    <string name="fx045g_desc_hyper_glitch">Glitch pesado: fatias que escorregam, blocos fora do lugar, separação RGB, rastros de pixels, compressão e cores trocadas — tudo por uma intensidade e uma semente animáveis.</string>
    <string name="fx045g_name_block_glitch">Glitch de blocos</string>
    <string name="fx045g_desc_block_glitch">Blocos retangulares deslocados, com canais trocados e separados, no estilo do Block Glitch do DaVinci Resolve. Controle o tamanho, a quantidade e a frequência dos blocos.</string>
