# =============================================================================
#  Modelo da chave de UPLOAD do Google Play.
#
#  Copie para `android/keystore.properties` (mesma pasta deste arquivo) e
#  preencha. O keystore.properties e o .jks estão no .gitignore: NUNCA
#  versione, imprima em log de CI nem envie para lugar nenhum.
#
#  Criar a chave (uma vez, guarde o .jks e as senhas em lugar seguro — sem a
#  chave de upload não sai atualização; o Google consegue redefinir a chave de
#  upload pelo Play Console, mas demora):
#
#    keytool -genkeypair -v -keystore C:/Users/<voce>/aurea-upload.jks ^
#      -alias aurea-upload -keyalg RSA -keysize 4096 -validity 10000 ^
#      -storetype PKCS12
#
#  (no Git Bash troque `^` por `\`). Com PKCS12 a senha da chave é a mesma da
#  keystore.
#
#  Com este arquivo presente, TODO build release (APK e AAB) é assinado com a
#  chave de upload. O Play Console re-assina com a chave de app do Google
#  (Play App Signing). Sem ele, `./gradlew :app:bundleRelease` falha de
#  propósito: o Play recusa bundle assinado com chave de debug.
#
#  Caminho relativo em storeFile resolve a partir de android/.
# =============================================================================

storeFile=C:/Users/<voce>/aurea-upload.jks
storePassword=<senha-da-keystore>
keyAlias=aurea-upload
keyPassword=<senha-da-chave>
