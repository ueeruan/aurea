    },
    "id": {
      "semProjeto": "Buka proyek untuk membuat teks.",
      "vazio": "Tulis teks terlebih dahulu.",
      "acao": "Teks animasi",
      "pronto": "{0} lapisan teks dibuat.",
      "semSelecao": "Pilih lapisan di linimasa.",
      "animadas": "{0} lapisan dianimasikan.",
      "estilo0": "Naik {0} px sambil muncul.",
      "estilo1": "Membesar dari nol ke ukuran normal.",
      "estilo2": "Masuk bergeser dari kiri.",
      "estilo3": "Berputar seperempat sambil muncul."
    },
    "ru": {
