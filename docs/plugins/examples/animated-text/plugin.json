    "ar": {
      "semProjeto": "افتح مشروعًا لإنشاء النص.",
      "vazio": "اكتب نصًا أولًا.",
      "acao": "نص متحرك",
      "pronto": "تم إنشاء {0} طبقة نص.",
      "semSelecao": "اختر طبقة في المخطط الزمني.",
      "animadas": "تم تحريك {0} طبقة.",
      "estilo0": "يصعد {0} بكسل أثناء الظهور.",
      "estilo1": "يكبر من الصفر إلى حجمه الطبيعي.",
