{
  "aureaPlugin": 3,
  "id": "aurea.example.audio-eq",
  "version": "1.0.0",
  "name": "Parametric EQ",
  "author": "Aurea",
  "kind": "audio",
  "params": [
    {
      "id": "frequency",
      "label": "Frequency (Hz)",
      "type": "float",
      "default": 1000,
      "min": 20,
      "max": 22000
    },
    {
      "id": "q",
      "label": "Q",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 20
    },
    {
      "id": "gain_db",
      "label": "Gain (dB)",
      "type": "float",
      "default": 0,
      "min": -24,
      "max": 24
    }
  ],
  "audio": {
    "nodes": [
      {
        "id": "source",
        "type": "input"
      },
      {
        "id": "output",
        "type": "eq",
        "input": "source",
        "frequency": {
          "param": "frequency",
          "scale": 1,
          "offset": 0
        },
        "q": {
          "param": "q",
          "scale": 1,
          "offset": 0
        },
        "gainDb": {
          "param": "gain_db",
          "scale": 1,
          "offset": 0
        }
      }
    ],
    "output": "output"
  }
}
