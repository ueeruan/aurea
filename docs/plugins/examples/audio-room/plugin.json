{
  "aureaPlugin": 3,
  "id": "aurea.example.audio-room",
  "version": "1.0.0",
  "name": "Algorithmic room reverb",
  "author": "Aurea",
  "kind": "audio",
  "params": [
    {
      "id": "size",
      "label": "Room size",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "decay",
      "label": "Feedback decay",
      "type": "float",
      "default": 0.75,
      "min": 0,
      "max": 0.95
    },
    {
      "id": "pre_delay",
      "label": "Pre-delay (ms)",
      "type": "float",
      "default": 15,
      "min": 1,
      "max": 250
    },
    {
      "id": "damping",
      "label": "Damping (Hz)",
      "type": "float",
      "default": 6000,
      "min": 200,
      "max": 20000
    },
    {
      "id": "mix",
      "label": "Wet mix",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1
    }
  ],
  "audio": {
    "nodes": [
      {
        "id": "source",
        "type": "input"
      },
      {
        "id": "pre",
        "type": "delay",
        "input": "source",
        "timeMs": {
          "param": "pre_delay",
          "scale": 1,
          "offset": 0
        },
        "feedback": 0,
        "maxDelayMs": 250
      },
      {
        "id": "comb0",
        "type": "delay",
        "input": "pre",
        "timeMs": {
          "param": "size",
          "scale": 40,
          "offset": 29
        },
        "feedback": {
          "param": "decay",
          "scale": 1,
          "offset": 0
        },
        "dampingHz": {
          "param": "damping",
          "scale": 1,
          "offset": 0
        },
        "maxDelayMs": 150
      },
      {
        "id": "comb1",
        "type": "delay",
        "input": "pre",
        "timeMs": {
          "param": "size",
          "scale": 50,
          "offset": 37
        },
        "feedback": {
          "param": "decay",
          "scale": 1,
          "offset": 0
        },
        "dampingHz": {
          "param": "damping",
          "scale": 1,
          "offset": 0
        },
        "maxDelayMs": 150
      },
      {
        "id": "comb2",
        "type": "delay",
        "input": "pre",
        "timeMs": {
          "param": "size",
          "scale": 60,
          "offset": 43
        },
        "feedback": {
          "param": "decay",
          "scale": 1,
          "offset": 0
        },
        "dampingHz": {
          "param": "damping",
          "scale": 1,
          "offset": 0
        },
        "maxDelayMs": 150
      },
      {
        "id": "comb3",
        "type": "delay",
        "input": "pre",
        "timeMs": {
          "param": "size",
          "scale": 70,
          "offset": 53
        },
        "feedback": {
          "param": "decay",
          "scale": 1,
          "offset": 0
        },
        "dampingHz": {
          "param": "damping",
          "scale": 1,
          "offset": 0
        },
        "maxDelayMs": 150
      },
      {
        "id": "diffuse",
        "type": "mix",
        "inputs": [
          "comb0",
          "comb1",
          "comb2",
          "comb3"
        ],
        "gains": [
          0.25,
          0.25,
          0.25,
          0.25
        ]
      },
      {
        "id": "allpass",
        "type": "allpass",
        "input": "diffuse",
        "timeMs": 7,
        "feedback": 0.5,
        "maxDelayMs": 8
      },
      {
        "id": "output",
        "type": "mix",
        "inputs": [
          "source",
          "allpass"
        ],
        "gains": [
          {
            "param": "mix",
            "scale": -1,
            "offset": 1
          },
          {
            "param": "mix",
            "scale": 1,
            "offset": 0
          }
        ]
      }
    ],
    "output": "output"
  }
}
