{
  "aureaPlugin": 1,
  "id": "com.aurea.examples.rgbwave",
  "version": "1.0.0",
  "author": "AUREA (exemplo)",
  "name": {
    "pt-BR": "Onda RGB",
    "en": "RGB Wave",
    "es": "Onda RGB",
    "ru": "RGB-волна",
    "hi": "आरजीबी तरंग",
    "id": "Gelombang RGB",
    "ar": "موجة RGB"
  },
  "description": {
    "pt-BR": "Separa os canais vermelho e azul numa onda que corre pela imagem.",
    "en": "Splits the red and blue channels along a wave that travels across the image."
  },
  "category": "Glitch",
  "kind": "shader",
  "params": [
    { "id": "amount", "type": "float", "label": { "pt-BR": "Deslocamento (px)", "en": "Offset (px)" },
      "default": 12, "min": 0, "max": 80 },
    { "id": "wave", "type": "float", "label": { "pt-BR": "Onda", "en": "Wave" },
      "default": 1, "min": 0, "max": 1 },
    { "id": "frequency", "type": "float", "label": { "pt-BR": "Frequência", "en": "Frequency" },
      "default": 6, "min": 0, "max": 40 },
    { "id": "speed", "type": "float", "label": { "pt-BR": "Velocidade", "en": "Speed" },
      "default": 1, "min": 0, "max": 10 },
    { "id": "direction", "type": "angle", "label": { "pt-BR": "Direção", "en": "Direction" },
      "default": 0, "min": -180, "max": 180 },
    { "id": "tint", "type": "color", "label": { "pt-BR": "Cor", "en": "Tint" },
      "default": "#FFFFFF" }
  ],
  "passes": [
    { "shader": "rgb_wave.frag" }
  ],
  "margin": 80
}
