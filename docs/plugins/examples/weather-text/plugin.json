{
  "aureaPlugin": 2,
  "id": "com.aurea.examples.weathertext",
  "version": "1.0.0",
  "author": "AUREA",
  "name": {
    "pt-BR": "Clima na tela",
    "en": "Weather on screen",
    "es": "El clima en pantalla",
    "hi": "स्क्रीन पर मौसम",
    "id": "Cuaca di layar",
    "ru": "Погода на экране",
    "ar": "الطقس على الشاشة"
  },
  "description": {
    "pt-BR": "Busca a temperatura agora de uma cidade na API pública Open-Meteo e cria uma camada de texto com ela. Exemplo de fetch com domínio declarado.",
    "en": "Fetches the current temperature of a city from the public Open-Meteo API and creates a text layer with it. A fetch example with a declared domain.",
    "es": "Busca la temperatura actual de una ciudad en la API pública Open-Meteo y crea una capa de texto con ella. Ejemplo de fetch con dominio declarado.",
    "hi": "सार्वजनिक Open-Meteo API से किसी शहर का अभी का तापमान लाता है और उससे टेक्स्ट परत बनाता है। घोषित डोमेन के साथ fetch का उदाहरण।",
    "id": "Mengambil suhu saat ini sebuah kota dari API publik Open-Meteo dan membuat lapisan teks darinya. Contoh fetch dengan domain yang dideklarasikan.",
    "ru": "Получает текущую температуру города из открытого API Open-Meteo и создаёт с ней текстовый слой. Пример fetch с объявленным доменом.",
    "ar": "يجلب درجة الحرارة الحالية لمدينة من واجهة Open-Meteo العامة وينشئ بها طبقة نص. مثال على fetch مع نطاق مُعلن."
  },
  "kind": "panel",
  "script": "main.js",
  "permissions": { "network": ["open-meteo.com"] },
  "ui": {
    "panels": [
      {
        "id": "main",
        "icon": "cloud",
        "placement": ["editor.panel"],
        "onOpen": "abriu",
        "title": { "pt-BR": "Clima na tela", "en": "Weather on screen", "es": "El clima en pantalla", "hi": "स्क्रीन पर मौसम", "id": "Cuaca di layar", "ru": "Погода на экране", "ar": "الطقس على الشاشة" },
        "controls": [
          {
            "id": "cidade", "type": "text", "default": "São Paulo", "maxLength": 80,
            "label": { "pt-BR": "Cidade", "en": "City", "es": "Ciudad", "hi": "शहर", "id": "Kota", "ru": "Город", "ar": "المدينة" },
            "placeholder": { "pt-BR": "Ex.: Lisboa", "en": "E.g. London", "es": "Ej.: Madrid", "hi": "जैसे: दिल्ली", "id": "Mis.: Jakarta", "ru": "Напр.: Москва", "ar": "مثال: القاهرة" }
          },
          {
            "id": "unidade", "type": "choice", "default": 0,
            "label": { "pt-BR": "Unidade", "en": "Unit", "es": "Unidad", "hi": "इकाई", "id": "Satuan", "ru": "Единицы", "ar": "الوحدة" },
            "options": ["°C", "°F"]
          },
          {
            "id": "buscar", "type": "button", "style": "secondary", "onClick": "buscar",
            "label": { "pt-BR": "Buscar", "en": "Search", "es": "Buscar", "hi": "खोजें", "id": "Cari", "ru": "Найти", "ar": "بحث" }
          },
          {
            "id": "lugares", "type": "list", "onSelect": "escolheu",
            "label": { "pt-BR": "Resultados", "en": "Results", "es": "Resultados", "hi": "परिणाम", "id": "Hasil", "ru": "Результаты", "ar": "النتائج" }
          },
          {
            "id": "resultado", "type": "label",
            "text": { "pt-BR": "Busque uma cidade.", "en": "Search for a city.", "es": "Busca una ciudad.", "hi": "कोई शहर खोजें।", "id": "Cari sebuah kota.", "ru": "Найдите город.", "ar": "ابحث عن مدينة." }
          },
          {
            "id": "criar", "type": "button", "style": "primary", "onClick": "criar",
            "label": { "pt-BR": "Criar texto", "en": "Create text", "es": "Crear texto", "hi": "टेक्स्ट बनाएँ", "id": "Buat teks", "ru": "Создать текст", "ar": "إنشاء نص" }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "abrir", "icon": "cloud", "placement": "editor.menu", "panel": "main",
        "title": { "pt-BR": "Clima na tela", "en": "Weather on screen", "es": "El clima en pantalla", "hi": "स्क्रीन पर मौसम", "id": "Cuaca di layar", "ru": "Погода на экране", "ar": "الطقس على الشاشة" }
      }
    ]
  },
