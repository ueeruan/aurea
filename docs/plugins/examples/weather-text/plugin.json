      "criado": "Text created.", "acao": "Weather on screen",
      "c0": "clear sky", "c1": "partly cloudy", "c45": "fog", "c51": "drizzle", "c61": "rain", "c71": "snow", "c80": "rain showers", "c95": "thunderstorm"
