// Gerado pelo CMake a partir de engine/cmake/AiDepthModel.incbin.cpp.in.
//
// Modelo de profundidade embutido (ver engine/assets/ai/README.md). Os 33 MB
// do .bin entram no objeto COMO ESTÃO, pelo `.incbin` do montador (Clang/GCC:
// Android e iOS): nenhum array de C++ gigante para o compilador ler. O MSVC
// (host de testes) não tem `.incbin` e usa cmake/EmbedDepthModel.cmake.
#include <cstddef>
#include <cstdint>

#if defined(__APPLE__)
#define AUREA_DEPTH_SECTION ".section __TEXT,__const\n"
#define AUREA_DEPTH_SYM(name) "_" name
#define AUREA_DEPTH_LOCAL(name) ".private_extern _" name "\n"
#else
#define AUREA_DEPTH_SECTION ".section .rodata.aurea_depth,\"a\"\n"
#define AUREA_DEPTH_SYM(name) name
#define AUREA_DEPTH_LOCAL(name) ".hidden " name "\n"
#endif
#define AUREA_DEPTH_LABEL(name) ".globl " AUREA_DEPTH_SYM(name) "\n" AUREA_DEPTH_LOCAL(name) AUREA_DEPTH_SYM(name) ":\n"

__asm__(
    AUREA_DEPTH_SECTION
    ".p2align 4\n"
    AUREA_DEPTH_LABEL("aurea_depth_model_bin")
    ".incbin \"@AI_DEPTH_BIN@\"\n"
    AUREA_DEPTH_LABEL("aurea_depth_model_bin_end")
    ".byte 0\n"
    ".p2align 4\n"
    AUREA_DEPTH_LABEL("aurea_depth_model_param")
    ".incbin \"@AI_DEPTH_PARAM@\"\n"
    ".byte 0\n"
    ".text\n");

extern "C" const unsigned char aurea_depth_model_bin[];
extern "C" const unsigned char aurea_depth_model_bin_end[];
extern "C" const char aurea_depth_model_param[];

namespace aurea::ai::embedded {
const unsigned char* depth_model_weights() { return aurea_depth_model_bin; }
std::size_t depth_model_weights_size() {
    return static_cast<std::size_t>(reinterpret_cast<std::uintptr_t>(aurea_depth_model_bin_end)
                                    - reinterpret_cast<std::uintptr_t>(aurea_depth_model_bin));
}
const char* depth_model_param() { return aurea_depth_model_param; }
}
