<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Aurea / platform / ios / app / Info.plist

  O QUE ESTE ARQUIVO NÃO TEM, E POR QUÊ:

   · A galeria integrada usa NSPhotoLibraryUsageDescription para mostrar as
     fotos e os vídeos aos quais a pessoa concedeu acesso.
   · NSMicrophoneUsageDescription existe para o "Gravar voz" (Adicionar →
     Áudio) e para o som do "Gravar agora" do AureaHyper (0.3.2): o pedido
     aparece quando a pessoa toca em Permitir/Gravar, e o áudio fica no aparelho.
   · NSCameraUsageDescription: a Real Camera (rastreio, sem gravar imagens) e o
     "Gravar agora" do AureaHyper (grava o vídeo que vai ser melhorado) e o
     "Gravar movimento" do Motion Capture (0.3.6; a pose é detectada no aparelho).
   · Dados de assinatura (Team ID, provisioning): quem assina é o dono, com a
     conta dele. Ver README.

  BUNDLE ID: com.aurea.aurea — o MESMO `applicationId` do
  android/app/build.gradle.kts. É o que faz um projeto aberto nos dois sistemas
  ser o mesmo app.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>pt-BR</string>
    <key>CFBundleDisplayName</key>
    <string>Aurea</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- 18/11/2026: tarefas contínuas do iOS 26+ (BGContinuedProcessingTask).
         UMA chave só (chave repetida num plist: só a última vale e o
         register() da outra derruba o app):
         · export.video: o export seguindo em segundo plano (ExportBackgroundRun
           em AureaModel.swift);
         · mcp.*: o AureaMCP que a pessoa liga para o agente seguir com o app
           fechado. Curinga: cada pedido usa <bundle>.mcp.agent<n>. -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).export.video</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).mcp.*</string>
    </array>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>AureaReleaseLabel</key>
    <string>1.0.8.2 BETA</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <!-- Build iOS do porte do editor Android atual. -->
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>O microfone grava a sua narração (Gravar voz) e o som dos vídeos que você grava no AureaHyper. O áudio fica no seu aparelho.</string>
    <key>NSCameraUsageDescription</key>
    <string>A câmera rastreia o movimento 3D do aparelho para animar a câmera do projeto (sem gravar imagens) e grava os vídeos que você pede em Gravar agora, no AureaHyper, e em Gravar movimento, no Motion Capture. O vídeo fica no seu aparelho.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Mostrar suas fotos e vídeos dentro do Aurea para escolher o que importar no projeto.</string>
    <key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
    <true/>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Salvar o vídeo exportado pelo Aurea na sua galeria.</string>
    <!-- 0.4.1: login com Google (Firebase Auth). Valores das build settings
         AUREA_FIREBASE_* (Firebase.xcconfig.example); vazios = botão some. -->
    <key>AureaFirebaseProjectID</key>
    <string>$(AUREA_FIREBASE_PROJECT_ID)</string>
    <key>AureaFirebaseAppID</key>
    <string>$(AUREA_FIREBASE_APP_ID)</string>
    <key>AureaFirebaseAPIKey</key>
    <string>$(AUREA_FIREBASE_API_KEY)</string>
    <key>AureaFirebaseClientID</key>
    <string>$(AUREA_FIREBASE_CLIENT_ID)</string>
    <key>AureaFirebaseSenderID</key>
    <string>$(AUREA_FIREBASE_SENDER_ID)</string>
    <!-- 0.4.1: a volta da folha do Google (GoogleSignIn) pelo client id invertido. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>google-signin</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$(AUREA_FIREBASE_REVERSED_CLIENT_ID)</string>
            </array>
        </dict>
        <!-- AureaMCP: "Abrir no Aurea" da página de autorização do agente (aurea://mcp/pair?code=…). -->
        <dict>
            <key>CFBundleURLName</key>
            <string>com.aurea.mcp</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>aurea</string>
            </array>
        </dict>
    </array>
    <key>UIAppFonts</key>
    <array>
        <string>CupertinoIcons.ttf</string>
        <string>Fonts/Roboto-Regular.ttf</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>


    <!-- O motor precisa de Metal. Sem esta exigência o app instalaria num
         aparelho sem GPU Metal e o preview nunca subiria — o mesmo critério do
         `uses-feature android.hardware.vulkan` required="true" do Android. -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>metal</string>
    </array>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- O Aurea é escuro em todas as telas (o tema do Android não tem modo
         claro). Fixar evita o sistema inverter o que não deve. -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- O app é árabe-tradutor-ready como o Android (`supportsRtl="true"`). -->
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>

    <!-- Os exports e os projetos ficam em Documents; deixar visível no app
         Arquivos é o que permite ao usuário pegar o vídeo exportado sem
         passar por uma folha de compartilhamento. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- External formats supported by the shared model importer. Files must
         see concrete data types even when no other model editor is installed. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>com.autodesk.fbx</string>
            <key>UTTypeDescription</key><string>FBX 3D model</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>fbx</string></array><key>public.mime-type</key><string>application/x-fbx</string></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.import.obj</string>
            <key>UTTypeDescription</key><string>Wavefront OBJ model</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>obj</string></array><key>public.mime-type</key><string>model/obj</string></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.import.glb</string>
            <key>UTTypeDescription</key><string>Binary glTF model</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>glb</string></array><key>public.mime-type</key><string>model/gltf-binary</string></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.import.gltf</string>
            <key>UTTypeDescription</key><string>glTF model</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>gltf</string></array><key>public.mime-type</key><string>model/gltf+json</string></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.import.mtl</string>
            <key>UTTypeDescription</key><string>Wavefront material</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>mtl</string></array></dict>
        </dict>
        <!-- Bugs 0.3.4 (importar projeto): o arquivo do projeto que chegou
             como .pjf em alguns aparelhos. O motor reconhece pelo conteúdo. -->
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.import.pjf</string>
            <key>UTTypeDescription</key><string>AUREA project file</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>pjf</string></array></dict>
        </dict>
        <!-- 1.0.8: projeto e modelo do After Effects. "Abrir com" chega pelo
             onOpenURL (AureaApp.swift) e o conteúdo decide a importação. -->
        <dict>
            <key>UTTypeIdentifier</key><string>com.adobe.after-effects.project</string>
            <key>UTTypeDescription</key><string>After Effects project</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>aep</string><string>aet</string></array></dict>
        </dict>
    </array>

    <!-- Bugs 0.3.4 (importar projeto): os tipos do AUREA. Sem eles, tocar num
         .aureaproj no app Arquivos, no AirDrop ou num mensageiro não oferecia o
         AUREA, e o arquivo chegava sem dono. O app recebe pelo `onOpenURL`
         (AureaApp.swift) e importa como projeto NOVO. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.project-package</string>
            <key>UTTypeDescription</key><string>AUREA project file</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>aureaproj</string></array><key>public.mime-type</key><string>application/x-aurea-project</string></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>com.aurea.project</string>
            <key>UTTypeDescription</key><string>AUREA project</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
            <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>aurea</string></array></dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>AUREA project file</string>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>LSHandlerRank</key><string>Owner</string>
            <key>LSItemContentTypes</key><array><string>com.aurea.project-package</string><string>com.aurea.project</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>AUREA project file (.pjf)</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.aurea.import.pjf</string></array>
        </dict>
        <!-- 1.0.8: After Effects (.aep/.aet) e os pacotes do "Coletar arquivos"
             (.zip, .rar); o AUREA aparece como alternativa, sem tomar o tipo. -->
        <dict>
            <key>CFBundleTypeName</key><string>After Effects project</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.adobe.after-effects.project</string><string>public.zip-archive</string><string>com.rarlab.rar-archive</string></array>
        </dict>
    </array>

    <!-- Sem criptografia própria: dispensa o aviso de conformidade a cada
         envio para a loja. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
